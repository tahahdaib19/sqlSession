DECLARE
V_BEGIN NUMBER :=7;
V_END NUMBER :=7;
V_STARS_COUNTER NUMBER;
BEGIN
FOR I IN 1..4  LOOP
FOR J IN 1..10   LOOP
IF J = V_BEGIN THEN
V_STARS_COUNTER :=V_END +1 - V_BEGIN;

WHILE V_STARS_COUNTER > 0 LOOP
DBMS_OUTPUT.PUT('*');
V_STARS_COUNTER:=V_STARS_COUNTER - 1;
END LOOP;
ELSE 
DBMS_OUTPUT.PUT(' ');
END IF;
END LOOP;
V_BEGIN :=V_BEGIN - 1;
V_END := V_END + 1;
END LOOP;
END;
